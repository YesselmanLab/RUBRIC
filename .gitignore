# ---- Build output (includes the fetched gemmi clone + all artifacts) --------
/build/
build*/
cmake-build-*/
*.o
*.a
*.dylib
*.so
*.dSYM/

# ---- Python package builds (python -m build, cibuildwheel) ------------------
/dist/
/wheelhouse/
*.egg-info/

# ---- CLI output written during use ------------------------------------------
# Any root-level JSON is `rubric --out` output (e.g. "1GID.json", "<id>_pairs.json").
# Anchored to root: does NOT touch resources/**/*.json (bundled).
/*.json
/*.out
/*.pml
*.pse
*.cif

# ---- OS / editor junk -------------------------------------------------------
.DS_Store
*.swp
*~
.idea/
.vscode/

# ---- Caches (clangd index, Python bytecode, generic tool caches) ------------
.cache/
**/.cache/
__pycache__/
*.pyc
*.pyo
